[Unit]
Description=FM Radio Web Service
After=network.target

[Service]
Type=simple
# 改成你的 Linux 用户名，例如 ubuntu / root
User=ubuntu
# 改成实际部署目录
WorkingDirectory=/opt/fmradio
Environment=PORT=8000
# 强制直连：不使用任何系统/环境代理
Environment=RB_PROXY_MODE=direct
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
ExecStart=/opt/fmradio/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
